# =========================================================================
# STAR NOVEL - cms-backend 生产环境变量配置 (Production Environment)
# =========================================================================

# 1. 运行模式与监听端口
GIN_MODE=release
PORT=8081

# 2. 阿里云 RDS PostgreSQL 专网连接 (与 reader-backend 保持一致)
DATABASE_URL=postgres://star_admin:YOUR_STRONG_RDS_PASSWORD@pgm-2ze8xxxxxx.pgsql.rds.aliyuncs.com:3433/star_novel_db?sslmode=disable

# 3. 自建 Redis 专网连接
REDIS_URL=redis://:YOUR_STRONG_REDIS_PASSWORD_2026@172.16.0.15:6379/0

# 4. CMS 管理员鉴权密钥
CMS_JWT_SECRET=CHANGE_ME_TO_A_UNIQUE_RANDOM_SECRET

# 5. 默认主站落地页域名
DEFAULT_DOMAIN=https://starsfic.com

# 6. 小说章节内容存储配置 (支持 "postgres" 或 "oss")
# 默认使用 postgres 数据库存储。若需切换至阿里云 OSS，配置 STORAGE_TYPE=oss 并填入 OSS 凭证
STORAGE_TYPE=postgres
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_ACCESS_KEY_ID=your_aliyun_oss_access_key_id
OSS_ACCESS_KEY_SECRET=your_aliyun_oss_access_key_secret
OSS_BUCKET=star-novel-content
OSS_BASE_PATH=novels

# 支付配置。生产 Compose 使用 config.yaml 生成 cms.env。
# 与 Reader 共用密钥环，格式为 v1:<32 字节密钥的 Base64>。
PAYMENT_CREDENTIAL_KEYS=
PAYMENT_CREDENTIAL_ACTIVE_KEY_VERSION=v1

# 旧账户按需填入渠道提供的凭据。
PAYPAL_WEBHOOK_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_CATALOG_LIVE_API_KEY=
STRIPE_CATALOG_SANDBOX_API_KEY=

# Conversion Center. Prefer the generated environment files for Compose deployments.
CONVERSION_ENVIRONMENT=production
CONVERSION_PRIVATE_URL=http://conversion-api:8092
CONVERSION_PRIVATE_TOKEN=
