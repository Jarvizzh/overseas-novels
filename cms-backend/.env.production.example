# =========================================================================
# STAR NOVEL - cms-backend 生产环境变量配置 (Production Environment)
# =========================================================================

# 1. 运行模式与监听端口
GIN_MODE=release
PORT=8081

# 2. 阿里云 RDS PostgreSQL 专网连接 (与 reader-backend 保持一致)
DATABASE_URL=postgres://star_admin:YOUR_STRONG_RDS_PASSWORD@pgm-2ze8xxxxxx.pgsql.rds.aliyuncs.com:3433/star_novel_db?sslmode=disable

# 3. 自建 Redis 专网连接
REDIS_URL=redis://:YOUR_STRONG_REDIS_PASSWORD_2026@172.16.0.15:6379/0

# 4. CMS 管理员鉴权密钥
JWT_SECRET=STAR_NOVEL_CMS_SUPER_KEY_PROD_2026_RANDOM_STRING

# 5. 默认主站落地页域名
DEFAULT_DOMAIN=https://starsfic.com

# 6. 小说章节内容存储配置 (支持 "postgres" 或 "oss")
# 默认使用 postgres 数据库存储。若需切换至阿里云 OSS，配置 STORAGE_TYPE=oss 并填入 OSS 凭证
STORAGE_TYPE=postgres
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_ACCESS_KEY_ID=your_aliyun_oss_access_key_id
OSS_ACCESS_KEY_SECRET=your_aliyun_oss_access_key_secret
OSS_BUCKET=star-novel-content
OSS_BASE_PATH=novels
