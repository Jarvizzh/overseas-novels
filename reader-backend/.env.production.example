# =========================================================================
# STAR NOVEL - reader-backend 生产环境变量配置 (Production Environment)
# =========================================================================

# 1. 运行模式与监听端口
GIN_MODE=release
PORT=8080

# 2. 阿里云 RDS PostgreSQL 专网连接 (替换为您的实际 RDS 内网 EndPoint)
# 格式: postgres://[账号]:[密码]@[RDS内网Host]:[端口]/[数据库名]?sslmode=disable
DATABASE_URL=postgres://star_admin:YOUR_STRONG_RDS_PASSWORD@pgm-2ze8xxxxxx.pgsql.rds.aliyuncs.com:3433/star_novel?sslmode=disable

# 3. 自建 Redis 专网连接 (替换为您的自建 Redis ECS 内网 IP 与密码)
# 格式: redis://:[密码]@[Redis内网IP]:[端口]/[分库编号]
REDIS_URL=redis://:YOUR_STRONG_REDIS_PASSWORD_2026@172.16.0.15:6379/0

# 4. JWT 鉴权密钥 (全集群多节点必须保持完全一致，生产环境严禁使用默认值)
JWT_SECRET=STAR_NOVEL_SUPER_PROD_JWT_SECRET_KEY_2026_RANDOM_STRING

# 5. 海外合规支付网关凭证 (Stripe & PayPal Live 凭证)
STRIPE_SECRET_KEY=sk_live_replace_with_actual_key
PAYPAL_CLIENT_ID=BAAIquRtW56m_KRBYRCVfhlOdVLb4Y6mt-5z7EG89Tp1s3OvoEt5xqH3diadraxtosePKWv3-Sg_dgjy98
PAYPAL_CLIENT_SECRET=EMOVrtemDSvcHAHhXuO9gMNFA4hZHeSjMW6g92SwmC09Z7UVWsUgj6LCzLv_YUEmJEdmZCYR5MN1QZTF
PAYPAL_MODE=live

# 6. 默认主站落地页域名
DEFAULT_DOMAIN=https://h5.star-novel.com

# 7. 小说章节内容存储配置 (支持 "postgres" 或 "oss")
# 默认使用 postgres 数据库存储。若需切换至阿里云 OSS，配置 STORAGE_TYPE=oss 并填入 OSS 凭证
STORAGE_TYPE=postgres
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_ACCESS_KEY_ID=your_aliyun_oss_access_key_id
OSS_ACCESS_KEY_SECRET=your_aliyun_oss_access_key_secret
OSS_BUCKET=star-novel-content
OSS_BASE_PATH=novels
